+
+// ---------------------------------------------------------------------------
+// FierCoin: built-in CPU miner (like the original Bitcoin/Litecoin "setgenerate").
+// Each thread builds its own block with a unique coinbase (thread id + counter),
+// so threads never repeat each other's work.
+// ---------------------------------------------------------------------------
+namespace {
+Mutex g_fier_miner_mutex;
+std::vector<std::thread> g_fier_miner_threads GUARDED_BY(g_fier_miner_mutex);
+std::string g_fier_miner_address GUARDED_BY(g_fier_miner_mutex);
+std::atomic<bool> g_fier_miner_stop{false};
+std::atomic<uint64_t> g_fier_miner_hashes{0};
+std::atomic<int64_t> g_fier_miner_start_ms{0};
+std::atomic<int> g_fier_miner_blocks{0};
+
+void FierMinerThread(ChainstateManager* chainman, const CTxMemPool* mempool, CScript coinbase_script, unsigned int thread_id)
+{
+    util::ThreadRename(strprintf("miner.%u", thread_id));
+    LogPrintf("FierCoin miner: thread %u started\n", thread_id);
+    unsigned int extra_nonce = 0;
+    const Consensus::Params& consensus = Params().GetConsensus();
+    while (!g_fier_miner_stop && !ShutdownRequested()) {
+        std::unique_ptr<CBlockTemplate> tmpl;
+        try {
+            tmpl = BlockAssembler(*mempool, Params()).CreateNewBlock(coinbase_script);
+        } catch (const std::exception& e) {
+            LogPrintf("FierCoin miner: could not create a block: %s\n", e.what());
+        }
+        if (!tmpl) {
+            UninterruptibleSleep(std::chrono::seconds{1});
+            continue;
+        }
+        CBlock& block = tmpl->block;
+        int height;
+        {
+            LOCK(cs_main);
+            const CBlockIndex* tip = ::ChainActive().Tip();
+            if (tip == nullptr || tip->GetBlockHash() != block.hashPrevBlock) continue;
+            height = tip->nHeight + 1;
+            CMutableTransaction coinbase(*block.vtx[0]);
+            coinbase.vin[0].scriptSig = CScript() << height << CScriptNum(++extra_nonce) << CScriptNum(thread_id);
+            assert(coinbase.vin[0].scriptSig.size() <= 100);
+            block.vtx[0] = MakeTransactionRef(std::move(coinbase));
+            block.hashMerkleRoot = BlockMerkleRoot(block);
+        }
+        const int64_t template_time = GetTime();
+        bool found = false;
+        block.nNonce = 0;
+        while (!g_fier_miner_stop && !ShutdownRequested()) {
+            if (CheckProofOfWork(block.GetPoWHash(), block.nBits, consensus)) {
+                found = true;
+                break;
+            }
+            ++block.nNonce;
+            if ((block.nNonce & 0x3ff) == 0) {
+                g_fier_miner_hashes += 0x400;
+                if (block.nNonce >= 0xfffff000) break;
+                if (GetTime() - template_time > 30) break; // refresh: new transactions and timestamp
+                if (WITH_LOCK(cs_main, return ::ChainActive().Tip()->GetBlockHash()) != block.hashPrevBlock) break; // someone found the block
+            }
+        }
+        if (!found) continue;
+        auto shared_block = std::make_shared<const CBlock>(block);
+        bool new_block = false;
+        if (chainman->ProcessNewBlock(Params(), shared_block, /* fForceProcessing */ true, &new_block) && new_block) {
+            ++g_fier_miner_blocks;
+            LogPrintf("FierCoin miner: thread %u found block %d (%s)\n", thread_id, height, block.GetHash().ToString());
+        }
+    }
+    LogPrintf("FierCoin miner: thread %u stopped\n", thread_id);
+}
+} // namespace
+
+void StopFierMiner()
+{
+    std::vector<std::thread> threads;
+    {
+        LOCK(g_fier_miner_mutex);
+        g_fier_miner_stop = true;
+        threads.swap(g_fier_miner_threads);
+    }
+    for (auto& t : threads) {
+        if (t.joinable()) t.join();
+    }
+}
+
+bool StartFierMiner(ChainstateManager& chainman, const CTxMemPool& mempool, const std::string& address, int threads, std::string& error)
+{
+    const CTxDestination dest = DecodeDestination(address);
+    if (address.empty()) {
+        error = "No address given. Copy one from the Receive tab and use: setgenerate true 2 YOUR_ADDRESS";
+        return false;
+    }
+    if (!IsValidDestination(dest) || dest.type() == typeid(StealthAddress)) {
+        error = "Invalid FierCoin address: " + address;
+        return false;
+    }
+    StopFierMiner();
+    if (threads <= 0) threads = std::max(1u, std::thread::hardware_concurrency() / 2);
+    threads = std::min(threads, 256);
+    const CScript script = GetScriptForDestination(dest);
+    LOCK(g_fier_miner_mutex);
+    g_fier_miner_stop = false;
+    g_fier_miner_hashes = 0;
+    g_fier_miner_blocks = 0;
+    g_fier_miner_start_ms = GetTimeMillis();
+    g_fier_miner_address = address;
+    for (int i = 0; i < threads; ++i) {
+        g_fier_miner_threads.emplace_back(FierMinerThread, &chainman, &mempool, script, (unsigned int)i);
+    }
+    LogPrintf("FierCoin miner: mining to %s with %d thread(s)\n", address, threads);
+    return true;
+}
+
+static UniValue FierMinerStatus()
+{
+    UniValue obj(UniValue::VOBJ);
+    LOCK(g_fier_miner_mutex);
+    const bool on = !g_fier_miner_threads.empty();
+    const int64_t elapsed_ms = GetTimeMillis() - g_fier_miner_start_ms;
+    obj.pushKV("generating", on);
+    obj.pushKV("threads", (int)g_fier_miner_threads.size());
+    obj.pushKV("address", on ? g_fier_miner_address : "");
+    obj.pushKV("hashespersec", on && elapsed_ms > 0 ? (double)g_fier_miner_hashes * 1000.0 / elapsed_ms : 0.0);
+    obj.pushKV("blocksfound", (int)g_fier_miner_blocks);
+    return obj;
+}
+
+static RPCHelpMan setgenerate()
+{
+    return RPCHelpMan{"setgenerate",
+        "\nTurn FierCoin mining on or off, using this computer's processor (CPU).\n"
+        "Mined coins go to the address you give.\n",
+        {
+            {"generate", RPCArg::Type::BOOL, RPCArg::Optional::NO, "true to start mining, false to stop."},
+            {"genproclimit", RPCArg::Type::NUM, /* default */ "half of your CPU cores", "How many CPU threads to mine with (-1 = default)."},
+            {"address", RPCArg::Type::STR, /* default */ "the -genaddress setting", "Your FierCoin address to receive mined coins."},
+        },
+        RPCResult{RPCResult::Type::OBJ, "", "", {
+            {RPCResult::Type::BOOL, "generating", "whether mining is on"},
+            {RPCResult::Type::NUM, "threads", "number of mining threads"},
+            {RPCResult::Type::STR, "address", "address receiving mined coins"},
+            {RPCResult::Type::NUM, "hashespersec", "current mining speed"},
+            {RPCResult::Type::NUM, "blocksfound", "blocks found since mining started"},
+        }},
+        RPCExamples{
+            HelpExampleCli("setgenerate", "true 2 \"firc1q...\"") +
+            HelpExampleCli("setgenerate", "false")
+        },
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+{
+    if (!request.params[0].get_bool()) {
+        StopFierMiner();
+        return FierMinerStatus();
+    }
+    const int threads = request.params[1].isNull() ? -1 : request.params[1].get_int();
+    const std::string address = request.params[2].isNull() ? gArgs.GetArg("-genaddress", "") : request.params[2].get_str();
+    std::string error;
+    if (!StartFierMiner(EnsureChainman(request.context), EnsureMemPool(request.context), address, threads, error)) {
+        throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY, error);
+    }
+    return FierMinerStatus();
+},
+    };
+}
+
+static RPCHelpMan getgenerate()
+{
