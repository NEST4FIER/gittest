diff --git a/contrib/seeds/fiercoin-set-seeds.sh b/contrib/seeds/fiercoin-set-seeds.sh
new file mode 100755
index 0000000..7aad334
--- /dev/null
+++ b/contrib/seeds/fiercoin-set-seeds.sh
@@ -0,0 +1,36 @@
+#!/bin/bash
+# FierCoin: build the always-on seed nodes into the software, the way Bitcoin ships
+# its fixed seed list. New wallets use these to find the one shared FierCoin network;
+# after that they learn about other nodes from each other.
+#
+#   contrib/seeds/fiercoin-set-seeds.sh 203.0.113.10 198.51.100.7
+#
+# Each address is a public IPv4/IPv6 address of an always-on FierCoin node (port 29333).
+set -euo pipefail
+cd "$(dirname "$0")"
+[ $# -ge 1 ] || { echo "usage: $0 IP [IP...]"; exit 1; }
+: > nodes_main.txt
+for ip in "$@"; do
+  case "$ip" in
+    *:*:*) echo "[$ip]:29333" >> nodes_main.txt ;;   # IPv6
+    *)     echo "$ip:29333"   >> nodes_main.txt ;;
+  esac
+done
+: > nodes_test.txt
+python3 generate-seeds.py . > ../../src/chainparamsseeds.h
+# Use the list on the main network (it was switched off while FierCoin had no seed nodes).
+python3 - <<'EOF'
+p = '../../src/chainparams.cpp'
+s = open(p, encoding='utf-8').read()
+main_start = s.index('class CMainParams')
+main_end = s.index('class CTestNetParams')
+block = s[main_start:main_end]
+off = '        vFixedSeeds.clear();\n'
+on = '        vFixedSeeds = std::vector<uint8_t>(std::begin(chainparams_seed_main), std::end(chainparams_seed_main));\n'
+if off in block:
+    block = block.replace(off, on, 1)
+elif on not in block:
+    raise SystemExit('could not find the mainnet fixed seed line in chainparams.cpp')
+open(p, 'w', encoding='utf-8').write(s[:main_start] + block + s[main_end:])
+EOF
+echo "Seed list built in:"; cat nodes_main.txt
